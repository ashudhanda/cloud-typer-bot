# from @BotFather (/newbot)
BOT_TOKEN=123456:replace-me

# hackatime: hackatime.hackclub.com → settings → api key
# wakatime: wakatime.com/api-key
WAKA_API_KEY=replace-me

# default is hackatime. for wakatime.com use https://wakatime.com/api/v1
WAKA_API_URL=https://hackatime.hackclub.com/api/hackatime/v1

# only needed if "current" 404s on your server — set your username/id
# WAKA_USER=current

# your telegram chat id (message the bot /id after first deploy) — locks the bot to you
OWNER_ID=

# optional default project name
DEFAULT_PROJECT=webos
